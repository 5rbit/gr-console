TYPE "LGR_LaserDiagEntry"
VERSION : 0.1
   STRUCT
      TimeStamp {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;   //    기록 시각 (PLC 로컬 시간)
      Seq : UDInt;   //    기록 일련번호
      Source : USInt;   //    1 PICK 하강, 2 MeasureItem 들어갈 때, 3 MeasureItem 나갈 때, 4 수동 측정
      Code : UDInt;   //    아이템 코드 (수동 측정 0)
      Valid : Bool;   //    원 맞춤 성공
      FitError : Int;
      DiagFlags : Word;   //    LGR_MeasureTireResult.DiagFlags
      BeadDev : Array[0..3] of Real;   //    방향별 비드 높이 편차 (mm)
      EdgeHeight : Array[0..3] of Real;   //    방향별 안/밖 경계 높이 (mm)
      Samples : Array[0..3] of Int;
      Jumps : Array[0..3] of Int;
      Spread : Real;
      PlanarResidual : Real;
      ZOffset : Array[0..3] of Real;   //    측정 시점 PARA Z 오프셋 (mm)
   END_STRUCT;

END_TYPE

