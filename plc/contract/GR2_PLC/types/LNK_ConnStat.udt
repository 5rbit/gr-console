TYPE "LNK_ConnStat"
VERSION : 0.1
   STRUCT
      State : USInt;   //     LNK_ST_* 연결 상태
      Up : Bool;   //     TCP 연결 수립됨
      PeerHello : Bool;   //     이번 연결에서 피어 Hello 수신
      LastErr : Int;   //     마지막 오류 (LNK_ERR_* / LNK_E_*)
      LastStatus : Word;   //     마지막 TCON / TSEND / TRCV / TDISCON STATUS
      Reconnects : UDInt;   //     재접속 횟수
      RxMsg : UDInt;   //     수신 메시지 수
      TxMsg : UDInt;   //     송신 메시지 수
      RxErr : UDInt;   //     수신 오류 수 (프레이밍 / 파싱)
      TxErr : UDInt;   //     송신 오류 수
      AckTimeouts : UDInt;   //     Ack 대기 시간 초과 수
      MeasSent : UDInt;   //     MeasLog 송신 수
      MeasLost : UDInt;   //     전송하지 못하고 건너뛴 MeasLog 수
      CmdRx : UDInt;   //     Command 수신 수
      CmdRejected : UDInt;   //     Prefilter / 검증 거부 수
      CmdDeferred : UDInt;   //     GRM 수신과 겹쳐 미룬 횟수
      TraceTx : UDInt;   //     Trace 청크 송신 수
      MaxRunUs : UDInt;   //     세션 1 회 실행 최대 시간 (µs)
      LastRxSeq : UInt;   //     마지막 수신 Seq
      LastTxSeq : UInt;   //     마지막 송신 Seq
   END_STRUCT;

END_TYPE

