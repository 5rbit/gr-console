TYPE "LGR_Interface_GR_Command"
VERSION : 0.1
   STRUCT
      NTP {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;
      Header { S7_SetPoint := 'False'} : "LGR_Command_Header";
      Command : "LGR_Command_Command";
      Data : Array[0..15] of Byte;
      TaskData { S7_SetPoint := 'False'} : "LGR_Task_Data";
   END_STRUCT;

END_TYPE

