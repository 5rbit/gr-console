         p1072 : Real;   //                  [p1072]
         p1073 : Real;   //                  [p1073]
         p1074 : Real;   //                  [p1074]
         p1075 : Real;   //                  [p1075]
         p1076 : Real;   //                  [p1076]
         p1077 : Real;   //                  [p1077]
         p1078 : Real;   //                  [p1078]
         p1079 : Real;   //                  [p1079]
         p1080 : Real;   //                  [p1080]
         p1081 : Real;   //                  [p1081]
