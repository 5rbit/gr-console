         p1085 : Real;   //                  [p1085]
         p1086 : Real;   //                  [p1086]
         p1087 : Real;   //                  [p1087]
         p1088 : Real;   //                  [p1088]
         p1089 : Real;   //                  [p1089]
         CommGRM : Real;   //                  [p1090]  Mainpanel 통신 TimeOut 파라미터(ms),1000ms=1.0s
         CommGCS : Real;   //                  [p1091]  GCS 통신 TimeOut 파라미터(ms),1000ms=1.0s
         CommFrontGR : Real;   //                  [p1092]  GCS 통신 TimeOut 파라미터(ms),1000ms=1.0s
         CommRearGR : Real;   //                  [p1093]  GCS 통신 TimeOut 파라미터(ms),1000ms=1.0s
         p1094 : Real;   //                  [p1094]
         p1095 : Real;   //                  [p1095]
         p1096 : Real;   //                  [p1096]
         p1097 : Real;   //                  [p1097]
         CsvImport : Real;   //                  [p1098]  파라미터 파일(CSV) 읽기 TimeOut 파라미터(s)
         CsvExport : Real;   //                  [p1099]  파라미터 파일(CSV) 쓰기 TimeOut 파라미터(s)
      END_STRUCT;
      SpeedSet { S7_SetPoint := 'False'} : Array["X".."G", 0..9] of "LGR_PARA_SpeedSet";   //                  [p1100 - p1799] SpeedSet
   END_STRUCT;


