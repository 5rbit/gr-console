DATA_BLOCK "PARA"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
   STRUCT 
      Machine : Struct   //                  [p001 - p099] 장비 파라미터
         ID : USInt;   //                  [p1] Machine ID
         MachinType : USInt;   //                  [p2] Machin Type
         ToolType : USInt;   //                  [p3] Gripper Type
         LayoutType : USInt;   //                  [p4]
         p5 : USInt;   //                  [p5]
         p6 : USInt;   //                  [p6]
         p7 : USInt;   //                  [p7]
         ModuleCount : USInt;   //                  [p8] Modele Count
         AxisCount : USInt;   //                  [p9] AxisCount
         XLength : UInt;   //                  [p10] X-Axis Axis Length
         XLengthFront : UInt;   //                  [p11] X-Axis Axis Length Front
         XLengthRear : UInt;   //                  [p12] X-Axis Axis Length Rear
         AntiColMargin_Default : UInt;   //                  [p13] Collision Margin
         AntiColMargin_XAC : UInt;   //                  [p14] Collision Margin
         AntiColMargin_Pos : UInt;   //                  [p15] Collision Margin
         AntiColMargin_Avoid : UInt;   //                  [p16] Collision Margin
         p17 : UInt;   //                  [p17]
         p18 : UInt;   //                  [p18]
         p19 : UInt;   //                  [p19]
         Z_Drum_Turn : USInt;   //                  [p20] Z-Axis Drum Turn
         Z_BeltInitCount : USInt;   //                  [p21] Z_BeltInitCount
         Z_BeltThickness : Real;   //                  [p22] Z_BeltThickness
         Z_Drum_Dia : Real;   //                  [p23] Z-Axis  Drum Diameter
         Z_GripTipHeight : Real;   //                  [p24] Z-Axis  GripTip Height
         p25 : Real;   //                  [p25]
         p26 : Real;   //                  [p26]
         p27 : Real;   //                  [p27]
         p28 : Real;   //                  [p28]
         p29 : Real;   //                  [p29]
         G_LinkBase : Real;   //                  [p30] G-Axis LinkBase Length
         G_TipBase : Real;   //                  [p31] G-Axis TipBase Length
         G_Link : Real;   //                  [p32] G-Axis Link Length
         G_GHP : Real;   //                  [p33] G-Axis GHP Length
         G_Offset : Real;   //                  [p34] G-Axis ACS Offset
         G_Tip : Real;   //                  [p35] G-Axis Tip Length
         G_LeadScrewPitch : Real;   //                  [p36] G-Axis Lead Screw Pitch
         G_TorqRefDia : Real;   //                  [p37] G 토크 사양 기준 내경 (mm). 사양 Nm 은 이 내경에서의 값, 다른 내경은 링크각 비율로 환산 (GripperTorqAtPos). 0 이면 환산 없음
         G_OpenTorq_Nm : Real;   //                  [p38] OPEN(파지) 사양 모터 토크 @기준내경 (Nm, MotorRefTorque G 6.5 기준). 0 이면 p941 토크 % 그대로
         G_CloseTorq_Nm : Real;   //                  [p39] CLOSE(오므림) 사양 모터 토크 (Nm, 위치 환산 없음). 0 이면 p940 토크 % 그대로
         p40 : Real;   //                  [p40]
         p41 : Real;   //                  [p41]
         p42 : Real;   //                  [p42]
         p43 : Real;   //                  [p43]
         G_MeasureTorq_Nm : Real;   //                  [p44] MEASURE 접촉 사양 토크 @기준내경 (Nm). 0 이면 p952 → p941 / 수동 15 %
         G_ProtectForce_N : Real;   //                  [p45] 그리퍼 보호 상한 힘 (N). 위치별 토크로 환산해 모든 구간의 제한 상한. 0 이면 p46 만
         G_TorqMaxPct : Real;   //                  [p46] G 토크 제한 최종 상한 (%). 0 이면 100
         p47 : Real;   //                  [p47]
         p48 : Real;   //                  [p48]
         p49 : Real;   //                  [p49]
         MotorRefTorque : Array["X".."G"] of Real;   //                  [p50-p53]
         p54 : Real;   //                  [p54]
         p55 : Real;   //                  [p55]
         p56 : Real;   //                  [p56]
         p57 : Real;   //                  [p57]
         p58 : Real;   //                  [p58]
         p59 : Real;   //                  [p59]
         p60 : Real;   //                  [p60]
         p61 : Real;   //                  [p61]
         p62 : Real;   //                  [p62]
         p63 : Real;   //                  [p63]
         p64 : Real;   //                  [p64]
         p65 : Real;   //                  [p65]
         p66 : Real;   //                  [p66]
         p67 : Real;   //                  [p67]
         p68 : Real;   //                  [p68]
         p69 : Real;   //                  [p69]
         p70 : Real;   //                  [p70]
         p71 : Real;   //                  [p71]
         p72 : Real;   //                  [p72]
         p73 : Real;   //                  [p73]
         p74 : Real;   //                  [p74]
         p75 : Real;   //                  [p75]
         p76 : Real;   //                  [p76]
         p77 : Real;   //                  [p77]
         p78 : Real;   //                  [p78]
         p79 : Real;   //                  [p79]
         HomeDogLen : Array["X".."G"] of Real;   //                  [p80-p83] Home Dog Length
         p84 : Real;   //                  [p84]
         p85 : Real;   //                  [p85]
         p86 : Real;   //                  [p86]
         p87 : Real;   //                  [p87]
         p88 : Real;   //                  [p88]
         p89 : Real;   //                  [p89]
         p90 : Real;   //                  [p90]
         p91 : Real;   //                  [p91]
         p92 : Real;   //                  [p92]
         p93 : Real;   //                  [p93]
         p94 : Real;   //                  [p94]
         p95 : Real;   //                  [p95]
         CellOriginDogLen : Array["X".."Y"] of Real;   //                  [p96-p97] Cell Origin Dog Len
         StandAloneRangeXMin : Real;   //                  [p98] StandAlone Range Min
         StandAloneRangeXMax : Real;   //                  [p99] StandAlone Range Max
      END_STRUCT;
      "Network" : Struct   //                  [p100 - p149] 네트워크 파라미터
         Device : Array[0..3] of Byte;
         GR1 : Array[0..3] of Byte;
         GR2 : Array[0..3] of Byte;
         GR3 : Array[0..3] of Byte;
         GCS : Array[0..3] of Byte;
         GRM : Array[0..3] of Byte;
      END_STRUCT;
      DI_Config { S7_SetPoint := 'False'} : "GR_DI_Config";   //                  [p150 - p299] DI Config (Reserved 영역 포함)
      DQ_Config : "GR_DQ_Config";   //                  [p300 - p399] DQ Config (Reserved 영역 포함)
      Sensor : Struct   //                  [p400 - p499] Sensor 파라미터
         ItemDetectDistance_LL : Real;   //                  [p400]
         ItemDetectDistance_L : Real;   //                  [p401]
         ItemDetectDistance_M : Real;   //                  [p402]
         ItemDetectDistance_H : Real;   //                  [p403]
         LaserDiag_SpreadLimit : Real;   //                  [p404] 그리퍼 레이저 진단 : 한 측정의 방향별 비드 높이 편차 폭(최대-최소) 기준 (mm). 0 이면 8
         LaserDiag_PlanarLimit : Real;   //                  [p405] 그리퍼 레이저 진단 : TBR 비평면 성분 |(L+R)-(F+B)| 기준 (mm). 0 이면 4
         LaserDiag_JumpDist : Real;   //                  [p406] 그리퍼 레이저 진단 : 연속 샘플 거리 급변 기준 (mm). 0 이면 20
         LaserDiag_JumpCountLimit : Real;   //                  [p407] 그리퍼 레이저 진단 : 한 측정의 급변 횟수 기준 (회). 0 이면 5
         LaserDiag_ConsecLimit : Real;   //                  [p408] 그리퍼 레이저 진단 : 무응답 / 불안정 연속 측정 수 알람 기준 (회). 0 이면 3
         FLD_AntiColDistance : Real;   //                  [p409] FLD_AntiColDistance
         FLD_Offset : Real;   //                  [p410] FLDOffset
         XACF_Offset : Real;   //                  [p411] XAC_Front_Offset
         XACR_Offset : Real;   //                  [p412] XAC_Rear_Offset
         GIDL_Offset : Real;   //                  [p413] GDL Offset
         GIDF_Offset : Real;   //                  [p414] GDF Offset
         GIDR_Offset : Real;   //                  [p415] GDR Offset
         GIDB_Offset : Real;   //                  [p416] GDB Offset
         GIDType : USInt;
         GIDL_ZOffset : Real;   //                  [p418] GDL 높이 오프셋 (mm) : 빔 높이 - 그리퍼 Z 기준. 자동 교정(LASERDIAG.ZCal) 이 기록
         GIDF_ZOffset : Real;   //                  [p419] GDF 높이 오프셋 (mm) : 빔 높이 - 그리퍼 Z 기준. 자동 교정(LASERDIAG.ZCal) 이 기록
         GIDR_ZOffset : Real;   //                  [p420] GDR 높이 오프셋 (mm) : 빔 높이 - 그리퍼 Z 기준. 자동 교정(LASERDIAG.ZCal) 이 기록
         GIDB_ZOffset : Real;   //                  [p421] GDB 높이 오프셋 (mm) : 빔 높이 - 그리퍼 Z 기준. 자동 교정(LASERDIAG.ZCal) 이 기록 (TBR)
         LaserDiag_BiasLimit : Real;   //                  [p422] 그리퍼 레이저 진단 : 센서별 높이 편차 이동평균 알람 기준 (mm). 0 이면 5
         LaserDiag_BiasMinSamples : Real;   //                  [p423] 그리퍼 레이저 진단 : 높이 편차 알람 판정 최소 측정 수 (회). 0 이면 20
         LaserDiag_BiasAlpha : Real;   //                  [p424] 그리퍼 레이저 진단 : 높이 편차 이동평균 계수 (0~1). 0 이면 0.1
         LaserZCal_SampleCount : Real;   //                  [p425] 레이저 Z 오프셋 자동 교정 : 측정 횟수 (회). 0 이면 5
         LaserZCal_MaxStdDev : Real;   //                  [p426] 레이저 Z 오프셋 자동 교정 : 방향별 편차 표준편차 허용 (mm). 0 이면 2
         LaserZCal_MaxCorrection : Real;   //                  [p427] 레이저 Z 오프셋 자동 교정 : 방향별 보정량 허용 (mm). 0 이면 20
         LaserInnerDia_Offset : Real;   //                  [p428] 레이저 원 맞춤 내경 보정 (mm, 부호 포함) : 측정 내경에 더함. PICK / 들어갈 때 / 나갈 때 / 수동 측정 공통, 0 = 보정 없음
         LaserFit_TbrTolerance : Real;   //                  [p429] TBR 4점 원 맞춤 검증 허용 (mm) : 3점 원 중심에서 4번째 점까지 거리와 반지름 차이 한계, 넘으면 FitError 3. 0 이면 3
         LaserEdge_Latency : Real;   //                  [p430] 그리퍼 레이저 지연 (ms) : 측정 결과(들어갈 때/나갈 때/수동)의 경계·비드 높이를 이 시간만큼 이전의 Z 이력으로 역계산. 0 이면 보정 없음
         X1RD_Offset : Real;   //                  [p431] X1RD Offset
         X2RD_Offset : Real;   //                  [p432] X2RD Offset
         LaserCenter_OffsetLimit : Real;   //                  [p433] 중심(편심) 측정 허용 한계 (mm) : 편심 크기가 이 값을 넘으면 최대 3회까지 다시 측정, 3회 모두 넘으면 센서값 사용 불가 (PICK 은 보정 없이 파지, MeasureItem 은 Error). 0 이면 50
         MeasureLift_Extra : Real;   //                  [p434] 측정(MeasureItem) 완료 리프트 여유 (mm) : 셀 바닥 Z + 타이어 높이 + 이 값까지만 올리고 끝낸다 (홈 이하). 0 이면 100
         p435 : Real;
         p436 : Real;
         p437 : Real;
         p438 : Real;
         p439 : Real;
         p440 : Real;
         p441 : Real;
         p442 : Real;
         p443 : Real;
         p444 : Real;
         p445 : Real;
         p446 : Real;
         p447 : Real;
         p448 : Real;
         p449 : Real;
         p450 : Real;
         p451 : Real;
         p452 : Real;
         p453 : Real;
         p454 : Real;
         p455 : Real;
         p456 : Real;
         p457 : Real;
         p458 : Real;
         p459 : Real;
         p460 : Real;
         p461 : Real;
         p462 : Real;
         p463 : Real;
         p464 : Real;
         p465 : Real;
         p466 : Real;
         p467 : Real;
         p468 : Real;
         p469 : Real;
         p470 : Real;
         p471 : Real;
         p472 : Real;
         p473 : Real;
         p474 : Real;
         p475 : Real;
         p476 : Real;
         p477 : Real;
         p478 : Real;
         p479 : Real;
         p480 : Real;
         p481 : Real;
         p482 : Real;
         p483 : Real;
         p484 : Real;
         p485 : Real;
         p486 : Real;
         p487 : Real;
         p488 : Real;
         p489 : Real;
         p490 : Real;
         p491 : Real;
         p492 : Real;
         p493 : Real;
         p494 : Real;
         p495 : Real;
         p496 : Real;
         p497 : Real;
         p498 : Real;
         p499 : Real;
      END_STRUCT;
      Drive : Struct   //                  [p500 - p899] Drive
         SpeedFactor : Array["X".."G"] of Real;   //                  [p500-p515] 축 속도 배율 %
         PIN : Array["X".."G"] of Real;   //                  [p516-p531] 축 정위치 범위
         PIH : Array["X".."G"] of Real;   //                  [p532-p547] 축 정위치 해제 범위
         StandStillSpd : Array["X".."G"] of Real;   //                  [p548-p563]축 정지 결정 속도 (m/s) 파라미터
         StandStillDwellTime : Array["X".."G"] of Real;   //                  [p564-p579] 축 정지 결정 시간 파라미터
         FaultMargin : Array["X".."G"] of Real;   //                  [p580-p595] 축 포지셔닝 명령 허용 오차 파라미터(mm)
         JogTorqLimit : Array["X".."G"] of Real;   //                  [p596-p611] 축 조그 기동 시 토크 리미트(%) 파라미터
         InverseHomingDir : Array["X".."G"] of USInt;   //                  [p612-p627] Homing 방향 변경 파라메터
         RangeMin : Array["X".."G"] of Real;   //                  [p628-p643] 축 가동 최소 범위
         RangeMax : Array["X".."G"] of Real;   //                  [p644-p659] 축 가동 최소 범위
         HomePos : Array["X".."G"] of Real;   //                  [p660-p675] 축 홈 위치
         MaintPos : Array["X".."G"] of Real;   //                  [p676-p691] 축 Maintenance 위치
         UtilityPos_A : Array["X".."G"] of Real;   //                  [p692-p707] Utility Pos A
         UtilityPos_B : Array["X".."G"] of Real;   //                  [p708-p723] Utility Pos B
         CellOriginPos : Array["X".."Y"] of Real;   //                  [p756-p757] Cell Layout 원점
         SyncFltDiff : Real;   //                  [p772] X1, X2축 동기 오차 Fault 거리 파라미터
         SyncFltDiffMarginByVelocity : Real;   //                  [p773] X1, X2축 동기 오차 Fault 감지 거리 속도 마진 파라미터
         OriginPos : Array["X".."G"] of Real;   //                  [p784..p799] 드라이브 원점 위치 (ACS)
         MCS_TO_ACS : Array["X".."G", 0..2] of Real;   //                  [p800..p849] ACS 변환 계수
         ACS_TO_MCS : Array["X".."G", 0..2] of Real;   //                  [p850..p899] MCS 변환 계수
      END_STRUCT;
      Task : Struct   //                  [p900 - p999] Task
         CheckStation : Bool;   //                  [p900] 명령 수행 시 Station Interlock 확인 여부 파라미터
         CheckGoods : Bool;   //                  [p901] 명령 수행 시 물체 감지 센서 사용 여부, PICK 인 경우 타이어 빠짐 Detection
         CheckCellUse : Bool;   //                  [p902] 명령 수행 시 Cell 사용 여부 파라미터
         CheckCollision : Bool;   //                  [p903] 명령 수행 시 충돌방지 로직 사용 여부 파라미터
         EnablePreGrip : Bool;   //                  [p904] 명령 수행 시 PreGrip 사용 여부, PreGrip : PICK 명령 시 Gripper 를 PreGripDelta 거리 만큼 미리 이동 시키는 기능
         EnableCreepUp : Bool;   //                  [p905] PICK 명령 수행 이후 저속 들기 사용 여부 파라미터
         EnableCreepDown : Bool;   //                  [p906] DROP 명령 수행 시 저속 내려 놓기 사용 여부 파라미터
         EnableTorqBack : Bool;   //                  [p907] 명령 수행 시 일정 구간 Gripper TorqRelease 사용 여부 파라미터
         EnableInitializingBeforeAuto : Bool;   //                  [p908] 명령 수행 전 Initializing 확인 여부 파라미터
         Pick_BeadZCorrect : Bool;   //                  [p909] PICK Z 비드 보정 사용 (TRUE = 하강 중 본 마지막 상비드 - p973 로 목표 Z 를 올림, FALSE = 작업 Z 그대로). LastBeadPos 측정·기록은 항상 함
         p910 : Bool;   //                  [p910]
         p911 : Bool;   //                  [p911]
         p912 : Bool;   //                  [p912]
         p913 : Bool;   //                  [p913]
         p914 : Bool;   //                  [p914]
         p915 : Bool;   //                  [p915]
         p916 : Bool;   //                  [p916]
         p917 : Bool;   //                  [p917]
         p918 : Bool;   //                  [p918]
         p919 : Bool;   //                  [p919]
         p920 : Bool;   //                  [p920]
         p921 : Bool;   //                  [p921]
         p922 : Bool;   //                  [p922]
         p923 : Bool;   //                  [p923]
         p924 : Bool;   //                  [p924]
         p925 : Bool;   //                  [p925]
         p926 : Bool;   //                  [p926]
         p927 : Bool;   //                  [p927]
         p928 : Bool;   //                  [p928]
         p929 : Bool;   //                  [p929]
         BlendingDistance : Real;   //                  [p930] XYZ 블랜딩 거리(mm) 파라미터. 태스크 블렌드 = p930 → GCS 값 (0 이면 다음), 최종 = MIN(SpeedFactor x p930, 상한 p955~p957, 태스크 블렌드)
         MoveAllowZHeight : Real;   //                  [p931] XY 동작 허용 Z 높이(mm) 파라미터
         StationGoodsGap : Real;   //                  [p932] Station 다스택 적재 시 타이어 간의 거리 파라미터
         StationDragDistance : Real;   //                  [p933] Station Drag 이동 거리(mm) : p933 → GCS 값 (0 이면 다음)
         StationDragHeight : Real;   //                  [p934] Station Drag 시작 높이(mm) : p934 → GCS 값 (0 이면 다음)
         StationDragBlendDistance : Real;   //                  [p935] Station Drag 태스크 블렌드(mm) : 스테이션 드래그 태스크는 p930 대신 사용. 0 이면 p930
         PickSlowDownDistance : Real;   //                  [p936] PICK 상승 크립 거리(mm) : 바닥 셀(Z < 250) / 동작 스테이션 PICK 은 p936 → GCS → 200 (0 이면 다음), 그 외 PICK 은 GCS 값
         DropSlowDownDistance : Real;   //                  [p937] DROP 하강 크립 구간(mm) : p937 → GCS → 200 (0 이면 다음)
         DropOffset : Real;   //                  [p938] DROP 명령 수행 시 Z축 DROP 포지션 Offset 파라미터, 지정된 포지션 + Offset 위치에 DROP 명령을 수행 하게 됨
         PreGripDelta : Real;   //                  [p939] 명령 수행 중 PREGRIP시 타이어와의 거리 파라미터
         G_DropTorq_Factor : Real;   //                  [p940] DROP 명령 수행 시 Gripper Torq(%)  파라미터
         G_PickTorq_Factor : Real;   //                  [p941] PICK 명령 수행 시 Gripper Torq(%)  파라미터
         G_TorqLimitAllowDistance : Real;   //                  [p942] Gripper Torq 리미트 동작 시 Inposition 허용 거리(mm) 파라미터
         G_TorqRelease_Factor : Real;   //                  [p943] Gripper Torq Release 동작시 토크 제한 해제 % 파라미터
         G_TorqReleaseRemainZHeight : Real;   //                  [p944] Gripper Torq Release 동작 높이 (mm) 파라미터
         G_PickGripOffset : Real;   //                  [p945] Gripper PICK 명령시 Gripper Position Offset (mm) 파라미터
         G_PickGripOffset_Factor : Real;   //                  [p946] Gripper PICK 명령시 Gripper Position Offset (%) 파라미터, 명령 Position에 대한 추가 %를 의미한다
         PreDropHeight_Factor : Real;   //                  [p947] PreGrip Drop시 명령시 시작 Z 위치
         PrePickHeight_Factor : Real;   //                  [p948] PreGrip Pick 명령시 타이어 높이 대비 시작 위치 %
         G_TorqDetect_OnRatio : Real;   //                  [p949] Gripper 토크 검출 켜짐 기준(%) 파라미터, 적용 중 토크 제한값 대비. 0 이면 90
         G_TorqDetect_OffRatio : Real;   //                  [p950] Gripper 토크 검출 꺼짐 기준(%) 파라미터, 적용 중 토크 제한값 대비. 0 이면 70
         G_TorqDetect_DwellTime : Real;   //                  [p951] Gripper 토크 검출 켜짐 유지시간(s) 파라미터. 0 이면 0.2
         G_MeasureTorq_Factor : Real;   //                 [p952] 토크 내경 측정 시 Gripper 토크 제한(%) 파라미터. 0 이면 기존값 (자동 측정 G_PickTorq_Factor, 수동 측정 15)
         G_MeasureTorq_Offset : Real;   //                  [p953] 토크 내경 측정(자동, MeasureItem) 보정 (mm, 부호 포함) : 반복 평균 G 위치에 더함. 0 = 보정 없음 (기존 고정값 -5)
         G_MeasureTorq_OffsetManual : Real;   //                  [p954] 토크 내경 측정(수동) 보정 (mm, 부호 포함) : 토크 도달 G 위치에 더함. 0 = 보정 없음 (기존 고정값 -8)
         Blend_ShortCap : Real;   //                  [p955] 블렌드 상한(mm) : 스테이션 부분 리프트(DoublePicking) / 스테이션 PICK 목표 Z 가 p958 초과. 0 이면 250
         Blend_TbrCap : Real;   //                  [p956] 블렌드 상한(mm) : TBR 툴에서 p955 대신 사용. 0 이면 150
         Blend_MaxCap : Real;   //                  [p957] 블렌드 상한(mm) : 일반. 0 이면 500
         Blend_ShortZHeight : Real;   //                  [p958] 짧은 블렌드 적용 Z 높이(mm) : 스테이션 PICK 목표 Z 가 이보다 높으면 p955/p956 상한. 0 이면 2500
         CellDragHeight : Real;   //                  [p959] 셀 Drag 시작 높이(mm) : p959 → GCS 값 (0 이면 다음, 둘 다 0 이면 드래그 안 함)
         pickRetryCountMax : USInt;   //                  [p960]
         CellDragDistance : Real;   //                  [p961] 셀 Drag 이동 거리(mm) : p961 → GCS 값 (0 이면 다음)
         DragIn_DistMax : Real;   //                  [p962] Drag-In 이동 거리 상한(mm). 0 이면 150
         FLD_ZDecelDistance : Real;   //                  [p963] FLD 충돌방지 Z 감속 판정 거리(mm) : PICK / MOVE / MEASURE 하강. 0 이면 500
         LiftUp_BlendCellZHeight : Real;   //                  [p964] 블렌드 셀 작업 후 리프트업 완료로 보는 Z 높이(mm), 그 외 작업은 p931. 0 이면 2000
         ShortMove_XDistance : Real;   //                  [p965] PCR 짧은 X 이동 기준(mm) : X 이동이 이보다 짧고 아이템 3 개 이하면 X JerkTime = p967. 0 이면 4000
         ShortMove_YDistance : Real;   //                  [p966] PCR 짧은 Y 이동 기준(mm) : DoublePicking(아웃바운드 레이아웃 제외) Y 이동이 이보다 짧으면 Y JerkTime = p967. 0 이면 2000
         ShortMove_JerkTime : Real;   //                  [p967] PCR 짧은 XY 이동 JerkTime (드라이브 SV.JerkTime 단위). 0 이면 500
         NearMove_YDistance : Real;   //                  [p968] PCR 다른 셀 리프트업 기준(mm) : Y 이동이 이보다 짧으면 Z JerkTime = p969. 0 이면 1000
         NearMove_ZJerkTime : Real;   //                  [p969] PCR 다른 셀 리프트업 Z JerkTime (드라이브 SV.JerkTime 단위). 0 이면 100
         Pick_GripExtra : Real;   //                  [p970]
         Pick_GripBackDelta : Real;   //                  [p971]
         p972 : Real;   //                  [p972]
         Pick_BeadZOffset : Real;   //                  [p973] PICK Z 목표 보정(mm, 부호 포함) : 하강 중 본 마지막 비드 높이에서 이만큼 아래를 PICK 목표로 (보정 범위 = 작업 Z 위 타이어 높이 x 0.3 이내). 0 이면 20
         G_OpenTorq_Pct : Real;   //                  [p974] OPEN(파지) 사양 토크 사용자 조정 (%). 0 이면 100. p38 이 0 이면 p941 사용
         G_CloseTorq_Pct : Real;   //                  [p975] CLOSE(오므림) 사양 토크 사용자 조정 (%). 0 이면 100. p39 가 0 이면 p940 사용
         G_MeasureTorq_Pct : Real;   //                  [p976] MEASURE 접촉 사양 토크 사용자 조정 (%). 0 이면 100. p40 이 0 이면 p952 사용
         G_RetryTorq_Pct : Real;   //                  [p977] 재파지 토크 (OPEN 사양 대비 %). p38 이 0 이면 30 % 고정 (구 RETRY_G_TORQ)
         G_MeasureApproachMargin : Real;   //                  [p978] 측정 빠른 접근 여유 (mm) : 규격 내경 − 이 값까지 빠르게, 이후 느린 속도로 접촉. 0 이면 30
         G_MeasureSlowSpd : Real;   //                  [p979] 측정 느린 벌림 속도 등급 (SPD_* 값). 0 이면 SPD_MANU_LL
         G_ContactDwell : Real;   //                  [p980] 측정 접촉 판정 유지 시간 (s). 0 이면 0.1
         G_ContactFactor_k : Real;   //                  [p981] 측정 접촉 판정 : 기구 부하 대비 토크 상승 ≥ 접촉 사양 토크 × k. 0 이면 0.8
         G_ObstacleMargin : Real;   //                  [p982] 걸림 판정 (mm) : 규격 내경 − 이 값보다 앞에서 토크 정지하면 OBSTACLE. 0 이면 15
         G_GripRetryMax : Real;   //                  [p983] FB_Gripper 내부 재파지 횟수 (G 만 오므렸다 다시 벌림). 0 = 안 함. Z/XY 재시도는 Task
         G_AtSpeedTol : Real;   //                  [p984] 정속 판정 허용 (mm/s) : |PV.Speed − SV.Speed| 이하이면 AtSpeed. 0 이면 5
         G_HoldTorqPct : Real;   //                  [p985] 에러·대기 시 G 토크 제한 (%). 0 이면 기구 부하 + 5
         G_ErrorHoldTime : Real;   //                  [p986] 에러 확정 후 이 시간(s) 넘게 스톨이면 G 축 Disable (과열 보호). 0 이면 3
         G_HoldFactor : Real;   //                  [p987] HOLDING 정지 시 타이어 몫 축소 비율 (%). 100 = 안 줄임 (실기 확정 전 기본)
         G_HoldReduceTime : Real;   //                  [p988] HOLDING 정지 후 축소까지 (s). 0 이면 2
         G_MotorTempMax : Real;   //                  [p989] G 모터 온도 상한 (°C) : 넘으면 Thermal (요청 거부·Hold). 0 이면 드라이브 과열 경고 비트만
         G_LoadAvgMax : Real;   //                  [p990] G 평균 부하 상한 (%, HMI AverageLoad) : 넘으면 Thermal. 0 이면 검사 안 함
         p991 : Real;   //                  [p991]
         p992 : Real;   //                  [p992]
         p993 : Real;   //                  [p993]
         p994 : Real;   //                  [p994]
         p995 : Real;   //                  [p995]
         p996 : Real;   //                  [p996]
         p997 : Real;   //                  [p997]
         p998 : Real;   //                  [p998]
         p999 : Real;   //                  [p999]
      END_STRUCT;
      Timeout : Struct   //                  [p1000 - p1099] Timout
         PowerOn : Real;   //                  [p1000]  PowerOn 단계에서 TimeOut (ms) 파라미터, 1000ms = 1.0s
         DriveOn : Real;   //                  [p1001]  DriveOn 단계에서 TimeOut (ms) 파라미터, 1000ms = 1.0s
         DriveOffDly : Real;   //                  [p1002]  IDLE 상태에서 Drive Off 동작 타이머(ms), 1000ms = 1.0s
         DriveOffDlyForJog : Real;   //                  [p1003]  Manual, JOG 동작 시 Drive Off 동작 타이머(ms), 1000ms = 1.0s
         DriveReady : Real;   //                  [p1004]  명령 실행 전 DriveReady TimeOut 파라미터(ms), 1000ms=1.0s
         p1005 : Real;
         p1006 : Real;
         p1007 : Real;
         p1008 : Real;
         p1009 : Real;
         SetOrigin : Array["X".."X2"] of Real;   //                  [p1010-p1025] 축 원점 이동 Timeout
         p1026 : Real;   //                  [p1026]
         p1027 : Real;   //                  [p1027]
         p1028 : Real;   //                  [p1028]
         p1029 : Real;   //                  [p1029]
         BeltTentionOnDlyTime : Real;   //                  [p1030]
         Task_StepPre : Real;   //                  [p1031] 태스크 스텝 010/030/090 타임아웃 (s). 0 이면 기본값 20, 0 이하면 스텝 타임아웃 없이 전체 6001 만
         Task_Step100 : Real;   //                  [p1032] 태스크 스텝 100 [G] Home 타임아웃 (s). 0 이면 기본값 20
         Task_Step200 : Real;   //                  [p1033] 태스크 스텝 200 [Z] Lift-Up 타임아웃 (s). 0 이면 기본값 30
         Task_Step300 : Real;   //                  [p1034] 태스크 스텝 300 [XY] Travel 고정 여유 (s). 실제 한계 = 이 값 + ETA x p1039. 0 이면 기본값 20
         Task_Step400 : Real;   //                  [p1035] 태스크 스텝 400 [Z] Lift-Down 타임아웃 (s). 0 이면 기본값 40
         Task_StepRetry : Real;   //                  [p1036] 태스크 스텝 410~450 Grip Retry 타임아웃 (s). 0 이면 기본값 30
         Task_Step500 : Real;   //                  [p1037] 태스크 스텝 500 [G] Grip 타임아웃 (s). 0 이면 기본값 30
         Task_Step600 : Real;   //                  [p1038] 태스크 스텝 600 [Z] Lift-Up after complete 타임아웃 (s). 0 이면 기본값 40
         Task_StepMoveFactor : Real;   //                  [p1039] 300 주행 타임아웃 = Task_Step300 + 드라이브 추정 이동시간(ETA) x 이 배수. 0 이면 기본값 2.0
         p1040 : Real;   //                  [p1040]
         p1041 : Real;   //                  [p1041]
         p1042 : Real;   //                  [p1042]
         p1043 : Real;   //                  [p1043]
         p1044 : Real;   //                  [p1044]
         p1045 : Real;   //                  [p1045]
         p1046 : Real;   //                  [p1046]
         p1047 : Real;   //                  [p1047]
         p1048 : Real;   //                  [p1048]
         p1049 : Real;   //                  [p1049]
         p1050 : Real;   //                  [p1050]
         p1051 : Real;   //                  [p1051]
         p1052 : Real;   //                  [p1052]
         p1053 : Real;   //                  [p1053]
         p1054 : Real;   //                  [p1054]
         p1055 : Real;   //                  [p1055]
         p1056 : Real;   //                  [p1056]
         p1057 : Real;   //                  [p1057]
         p1058 : Real;   //                  [p1058]
         p1059 : Real;   //                  [p1059]
         CVInterlock : Real;   //                  [p1060] 스테이션(컨베이어) 인터락 타임아웃 (s). 400 F3119 / 600 F3118 공용. 0 이면 기본값 30
         p1061 : Real;   //                  [p1061]
         p1062 : Real;   //                  [p1062]
         p1063 : Real;   //                  [p1063]
         p1064 : Real;   //                  [p1064]
         p1065 : Real;   //                  [p1065]
         p1066 : Real;   //                  [p1066]
