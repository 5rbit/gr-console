DATA_BLOCK "TRACE_LNK"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
// 표준 접근 : PLC 링크 트레이스 (IL_LnkTrace 가 채우고 FB_LnkSession 이 Chunk 를 Trace 메시지로 보냄).
// 링크가 끊긴 동안에도 gr-console 이 S7 로 Chunk 를 직접 읽을 수 있게 표준 접근으로 둔다.
   STRUCT 
      LayoutSig : DWord;   //    레이아웃 서명 (gr-contract gen-sig 가 생성, 수동 수정 금지)
      Run : Bool;   //     샘플링 중
      CfgReq : Bool;   //     FB_LnkSession 이 CfgIn 을 채우고 세움 (IL_LnkTrace 가 지움)
      CfgSlot : USInt;   //     CfgIn 을 보낸 슬롯 (Ack 회신용)
      CfgAck : Int;   //     CfgIn 처리 결과 (0 정상 / LNK_E_TRACE_CFG)
      CfgDone : Bool;   //     CfgAck 가 새로 갱신됨 (세션이 Ack 를 보내고 지움)
      Cfg : "LNK_TraceCfg";   //     적용 중인 설정
      CfgIn : "LNK_TraceCfg";   //     수신 설정 (검증 전)
      Fill : Int;   //     채우는 중인 청크 (0..LNK_TRACE_CHUNK_LAST)
      Send : Int;   //     다음에 보낼 청크
      Ready : Int;   //     송신 대기 청크 수
      Rows : Int;   //     현재 청크의 행 수
      RowWords : Int;   //     한 행의 DWord 수 (1 + ChanCount)
      RowsMax : Int;   //     청크당 최대 행 수 (LNK_TRACE_WORDS / RowWords)
      DivCnt : UInt;   //     분주 카운터
      Overrun : UInt;   //     현재 청크에 실을 버린 샘플 수
      LastFlush : DInt;   //     현재 청크 시작 시각 (TIME_TCK, ms)
      RtMem : LReal;   //     RUNTIME 측정 메모리 (IL_LnkTrace 전용, 읽지 말 것)
      Stat : Struct   //     통계 (설정 시작 시 0)
         Samples : UDInt;   //     기록한 행 수
         Chunks : UDInt;   //     완성한 청크 수
         Dropped : UDInt;   //     링이 가득 차 버린 샘플 수 (누적)
         MaxRunUs : UDInt;   //     IL_LnkTrace 1 회 실행 최대 시간 (µs)
         CycleUs : UDInt;   //     마지막으로 읽은 OB123 사이클 시간 (µs)
         LastBadChan : Int;   //     설정 거부 시 문제가 된 채널 번호
      END_STRUCT;
      Chunk : Array[0.."LNK_TRACE_CHUNK_LAST"] of "LNK_Trace";   //     청크 링
   END_STRUCT;


BEGIN

END_DATA_BLOCK

