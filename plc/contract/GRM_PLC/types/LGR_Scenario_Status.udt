      NextReq { ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      NextReqMm { ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      Timeout : Real;
   END_STRUCT;

END_TYPE

