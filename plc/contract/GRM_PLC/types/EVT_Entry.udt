TYPE "EVT_Entry"
VERSION : 0.1
   STRUCT
      Seq : UDInt;   // = EVTLOG.Total at write time
      "Time" {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;
      Cat : USInt;
      Lvl : USInt;
      Src : UInt;
      Code : UInt;
      A : DInt;
      B : DInt;
      Ctx : UDInt;
   END_STRUCT;

END_TYPE
