      PreData : Struct
         Tracking { S7_SetPoint := 'False'} : Array["STATION_MIN".."STATION_MAX"] of "LGR_Station_TrackingData";
         Error : Array["STATION_MIN".."STATION_MAX"] of "LGR_Station_TrackingData";
         Last : Array["STATION_MIN".."STATION_MAX"] of "LGR_Station_TrackingData";
      END_STRUCT;
   END_STRUCT;


BEGIN

END_DATA_BLOCK

