          "description": "PLC index 0..1; missing trailing elements read as zero",
          "items": {"$ref": "#/$defs/LNK_FixtureSub"}
        }
      },
      "additionalProperties": false
    },
    "LNK_FixtureSub": {
      "title": "UDT \"LNK_FixtureSub\"",
      "type": "object",
      "properties": {
        "Id": {"type": "integer", "minimum": 0, "maximum": 65535},
        "Name": {"type": "string", "maxLength": 4, "description": "Latin-1 characters (U+0000..U+00FF)"},
        "On": {"type": "boolean"},
        "Pos": {
          "type": "array",
          "maxItems": 4,
          "description": "PLC index 1..4; missing trailing elements read as zero",
          "items": {
            "type": ["number", "null"],
            "description": "4 fraction digits, exponent form from 1e9; writers send null for NaN/Inf, PLC readers reject null"
          }
        }
      },
      "additionalProperties": false
    }
  }
