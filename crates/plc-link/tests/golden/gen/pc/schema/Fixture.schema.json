{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gr-link:FIXTURE:Fixture",
  "title": "Fixture (LNK_Fixture)",
  "description": "Link message Fixture (id 40, plc_to_pc), JSON envelope (docs/link/wire-spec.md section 2). data = UDT \"LNK_Fixture\" (sig 0xEB2E5DE0, 170 B standard layout)",
  "type": "object",
  "properties": {
    "type": {
      "description": "message name (readers also accept the numeric id)",
      "anyOf": [
        {"const": "Fixture"},
        {"const": 40}
      ]
    },
    "seq": {"type": "integer", "minimum": 0, "maximum": 65535},
    "sig": {
      "description": "UDT signature (0 = not checked)",
      "enum": [0, 3945684448]
    },
    "data": {"$ref": "#/$defs/LNK_Fixture"}
  },
  "required": ["type", "data"],
  "$defs": {
    "LNK_Fixture": {
      "title": "UDT \"LNK_Fixture\"",
      "type": "object",
      "properties": {
        "B0": {"type": "boolean", "description": "9 Bools cross a byte boundary"},
        "B1": {"type": "boolean"},
        "B2": {"type": "boolean"},
        "B3": {"type": "boolean"},
        "B4": {"type": "boolean"},
        "B5": {"type": "boolean"},
        "B6": {"type": "boolean"},
        "B7": {"type": "boolean"},
        "B8": {"type": "boolean"},
        "By": {"type": "integer", "minimum": 0, "maximum": 255},
        "Si": {"type": "integer", "minimum": -128, "maximum": 127},
        "I": {"type": "integer", "minimum": -32768, "maximum": 32767},
        "W": {"type": "integer", "minimum": 0, "maximum": 65535},
        "Di": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "Udi": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "R": {
          "type": ["number", "null"],
          "description": "4 fraction digits, exponent form from 1e9; writers send null for NaN/Inf, PLC readers reject null"
        },
        "Lr": {
          "type": ["number", "null"],
          "description": "4 fraction digits, exponent form from 1e9; writers send null for NaN/Inf, PLC readers reject null"
        },
        "Li": {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807},
        "Ch": {"type": "string", "minLength": 1, "maxLength": 1},
        "Str": {"type": "string", "maxLength": 8, "description": "Latin-1 characters (U+0000..U+00FF)"},
        "Ts": {
          "type": ["string", "null"],
          "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{0,9})?$",
          "description": "DTL; writers send YYYY-MM-DDTHH:MM:SS.mmm, \"\" / null read as 1970-01-01T00:00:00.000"
        },
        "Tm": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647, "description": "Time in milliseconds"},
        "Flags": {
          "type": "array",
          "maxItems": 3,
          "description": "PLC index 0..2; missing trailing elements read as zero",
          "items": {"type": "boolean"}
        },
        "Axis": {
          "type": "array",
          "maxItems": 3,
          "description": "PLC index 1..3; missing trailing elements read as zero",
          "items": {
            "type": ["number", "null"],
            "description": "4 fraction digits, exponent form from 1e9; writers send null for NaN/Inf, PLC readers reject null"
          }
        },
        "Grid": {
          "type": "array",
          "maxItems": 2,
          "description": "PLC index 1..2; missing trailing elements read as zero",
          "items": {
            "type": "array",
            "maxItems": 2,
            "description": "PLC index 0..1; missing trailing elements read as zero",
            "items": {"type": "integer", "minimum": -32768, "maximum": 32767}
          }
        },
        "Outer": {
          "type": "object",
          "properties": {
            "A": {"type": "integer", "minimum": 0, "maximum": 255},
            "Inner": {
              "type": "object",
              "properties": {
                "Flag": {"type": "boolean"},
                "Val": {"type": "integer", "minimum": 0, "maximum": 65535}
              },
              "additionalProperties": false
