FUNCTION "JsonR_LNK_Hello" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT
      Buf : Array[*] of Byte;   // 입력 버퍼
      Pos : DInt;   // 다음 읽을 절대 인덱스 (< 0 = 오류 유지)
      Val : "LNK_Hello";   // 읽은 값
   END_VAR

   VAR_TEMP
      k0 : String;   // 멤버 키 (Json_RNextKey)
      s : String;   // 문자열 멤버 임시 (Json_RStr)
   END_VAR


BEGIN
	// GENERATED by gr-contract gen-link from "LNK_Hello" sig 16#BFAD9982 - do not edit
	// 키 순서 무관, 모르는 키 / 초과 배열 요소는 건너뜀, 없는 키는 그대로. 오류면 Pos := LNK_JERR_PARSE (끈끈한 오류, 호출자가 끝에 한 번 확인)
	IF "Json_RObjBegin"(Buf := #Buf, Pos := #Pos) THEN
	  WHILE "Json_RNextKey"(Buf := #Buf, Pos := #Pos, Key => #k0) DO
	    IF #k0 = 'Plc' THEN
	      "Json_RStr"(Buf := #Buf, Pos := #Pos, MaxLen := 16, Val := #s);
	      IF #Pos >= 0 THEN
	        #Val.Plc := #s;
	      END_IF;
	    ELSIF #k0 = 'Proto' THEN
	      "Json_RUSInt"(Buf := #Buf, Pos := #Pos, Val := #Val.Proto);
	    ELSIF #k0 = 'Formats' THEN
	      "Json_RByte"(Buf := #Buf, Pos := #Pos, Val := #Val.Formats);
	    ELSIF #k0 = 'RegistryHash' THEN
	      "Json_RDWord"(Buf := #Buf, Pos := #Pos, Val := #Val.RegistryHash);
	    ELSIF #k0 = 'HeartbeatMs' THEN
	      "Json_RUDInt"(Buf := #Buf, Pos := #Pos, Val := #Val.HeartbeatMs);
	    ELSE
	      "Json_RSkip"(Buf := #Buf, Pos := #Pos);   // 모르는 키
	    END_IF;
	  END_WHILE;
	END_IF;
END_FUNCTION
