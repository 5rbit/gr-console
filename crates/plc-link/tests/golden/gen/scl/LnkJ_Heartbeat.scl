FUNCTION "LnkJ_Heartbeat" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT
      Seq : UInt;   // 엔벨로프 seq (1..65535, 0 = 없음)
   END_VAR

   VAR_IN_OUT
      Buf : Array[*] of Byte;   // 출력 버퍼
      Pos : DInt;   // 다음 쓸 절대 인덱스 (< 0 = 오류 유지)
   END_VAR


BEGIN
	// GENERATED by gr-contract gen-link from message "Heartbeat" (id 2, no payload) - do not edit
	// {"type":"Heartbeat","seq":<Seq>,"sig":0,"data":null}
	"Json_WRaw"(Buf := #Buf, Pos := #Pos, Lit := '{"type":"Heartbeat","seq":');
	"Json_WUInt"(Buf := #Buf, Pos := #Pos, Val := #Seq);
	"Json_WRaw"(Buf := #Buf, Pos := #Pos, Lit := ',"sig":0,"data":null}');
END_FUNCTION
