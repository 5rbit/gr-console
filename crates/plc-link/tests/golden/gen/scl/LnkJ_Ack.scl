{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT
      Seq : UInt;   // 엔벨로프 seq (1..65535, 0 = 없음)
   END_VAR

   VAR_IN_OUT
      Buf : Array[*] of Byte;   // 출력 버퍼
