FUNCTION "JsonR_LNK_Ack" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT
      Buf : Array[*] of Byte;   // 입력 버퍼
      Pos : DInt;   // 다음 읽을 절대 인덱스 (< 0 = 오류 유지)
      Val : "LNK_Ack";   // 읽은 값
   END_VAR

   VAR_TEMP
      k0 : String;   // 멤버 키 (Json_RNextKey)
      s : String;   // 문자열 멤버 임시 (Json_RStr)
   END_VAR


BEGIN
	// GENERATED by gr-contract gen-link from "LNK_Ack" sig 16#FF5482FF - do not edit
	// 키 순서 무관, 모르는 키 / 초과 배열 요소는 건너뜀, 없는 키는 그대로. 오류면 Pos := LNK_JERR_PARSE (끈끈한 오류, 호출자가 끝에 한 번 확인)
	IF "Json_RObjBegin"(Buf := #Buf, Pos := #Pos) THEN
	  WHILE "Json_RNextKey"(Buf := #Buf, Pos := #Pos, Key => #k0) DO
	    IF #k0 = 'RefType' THEN
	      "Json_RUInt"(Buf := #Buf, Pos := #Pos, Val := #Val.RefType);
	    ELSIF #k0 = 'RefSeq' THEN
	      "Json_RUInt"(Buf := #Buf, Pos := #Pos, Val := #Val.RefSeq);
	    ELSIF #k0 = 'Code' THEN
	      "Json_RInt"(Buf := #Buf, Pos := #Pos, Val := #Val.Code);
	    ELSIF #k0 = 'Text' THEN
	      "Json_RStr"(Buf := #Buf, Pos := #Pos, MaxLen := 40, Val := #s);
	      IF #Pos >= 0 THEN
	        #Val.Text := #s;
	      END_IF;
	    ELSE
	      "Json_RSkip"(Buf := #Buf, Pos := #Pos);   // 모르는 키
	    END_IF;
	  END_WHILE;
	END_IF;
END_FUNCTION
